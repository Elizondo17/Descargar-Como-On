{
  "entities": {
    "AuthorizedUser": {
      "title": "AuthorizedUser",
      "description": "Cloud-authorized operator or superuser account bound to verified Google Sign-In email and hardware devices.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable user identifier"
        },
        "email": {
          "type": "string",
          "description": "Normalized lowercase Google email matching document ID"
        },
        "username": {
          "type": "string",
          "description": "Display name of the operator or superuser"
        },
        "role": {
          "type": "string",
          "enum": ["SUPERUSER", "OPERATOR"],
          "description": "Authorization role"
        },
        "daysGranted": {
          "type": "integer",
          "description": "Total active days granted by admin"
        },
        "validFrom": {
          "type": "string",
          "format": "date-time",
          "description": "Activation timestamp written via FieldValue.serverTimestamp()"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Cloud-enforced license expiration timestamp"
        },
        "isBlocked": {
          "type": "boolean",
          "description": "Remote block switch controlled by Superuser"
        },
        "canAccessLegacyModules": {
          "type": "boolean",
          "description": "Per-user override to enable legacy EzoCRM tabs"
        },
        "notes": {
          "type": "string",
          "description": "Admin notes or shift details"
        },
        "maxDevices": {
          "type": "integer",
          "description": "Maximum allowed hardware devices (default 1, up to 5 for special cases)"
        },
        "boundDeviceIds": {
          "type": "array",
          "description": "Installation device IDs currently linked to this user (size <= maxDevices <= 5)"
        },
        "boundDeviceLabels": {
          "type": "array",
          "description": "Human-readable phone model labels aligned with boundDeviceIds"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID claimed on first Google Sign-In"
        },
        "updateRequired": {
          "type": "boolean",
          "description": "Per-user temporary update lock controlled by Superuser"
        },
        "requiredVersionCode": {
          "type": "integer",
          "description": "Minimum versionCode required to unlock the seller automatically"
        },
        "updateLockReason": {
          "type": "string",
          "description": "Optional reason or note shown on the update lock screen"
        },
        "accessToken": {
          "type": "string",
          "description": "Optional Cloud Access Token code used to activate this license"
        },
        "parentEmail": {
          "type": "string",
          "description": "Normalized email of the direct superior in the team hierarchy"
        },
        "supervisorChainEmails": {
          "type": "array",
          "description": "Ordered list of ancestor superior emails above this user (max 10)"
        },
        "hierarchyDepth": {
          "type": "integer",
          "description": "Depth level from pyramid root (0 = root, 1+ = subordinate level)"
        },
        "approvalStatus": {
          "type": "string",
          "enum": ["ACTIVE", "PENDING_APPROVAL", "REJECTED"],
          "description": "Superuser activation approval state"
        },
        "canManageSubUsers": {
          "type": "boolean",
          "description": "Whether this user can propose/view sub-users below them (Superuser editable)"
        },
        "visibilityDepth": {
          "type": "integer",
          "description": "Maximum subordinate depth visible below this user (0 = full subtree, N = max levels)"
        },
        "requestedByEmail": {
          "type": "string",
          "description": "Superior email who originally proposed this sub-user"
        },
        "tutorialCompleted": {
          "type": "boolean",
          "description": "Whether the seller has completed or dismissed the one-time interactive welcome tutorial"
        },
        "fcmToken": {
          "type": "string",
          "description": "Latest Firebase Cloud Messaging registration token for personalized push delivery"
        },
        "fcmUpdatedAtMs": {
          "type": "integer",
          "description": "Epoch milliseconds when the device FCM token was last refreshed"
        },
        "notifyCatalogUpdates": {
          "type": "boolean",
          "description": "Seller toggle for catalog and pricing update push notifications"
        },
        "notifyAssignedContacts": {
          "type": "boolean",
          "description": "Seller toggle for assigned contact push notifications"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation timestamp written via FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "id",
        "email",
        "username",
        "role",
        "daysGranted",
        "validFrom",
        "expiresAt",
        "isBlocked",
        "canAccessLegacyModules",
        "notes",
        "maxDevices",
        "boundDeviceIds",
        "boundDeviceLabels",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccessToken": {
      "title": "AccessToken",
      "description": "Cloud access token issued by the Superuser with assigned validity days for new users, redeemable once via Google Sign-In.",
      "type": "object",
      "properties": {
        "tokenCode": {
          "type": "string",
          "description": "Unique uppercase access token code matching document ID"
        },
        "assignedUsername": {
          "type": "string",
          "description": "Display name assigned to the new user"
        },
        "targetEmail": {
          "type": "string",
          "description": "Optional Google email restriction (empty string allows any authenticated Google account with the token)"
        },
        "daysGranted": {
          "type": "integer",
          "description": "License validity days assigned by Superuser (1..3650)"
        },
        "maxDevices": {
          "type": "integer",
          "description": "Maximum allowed hardware devices (1..5)"
        },
        "notes": {
          "type": "string",
          "description": "Optional admin notes or zone"
        },
        "status": {
          "type": "string",
          "enum": ["AVAILABLE", "REDEEMED", "REVOKED"],
          "description": "Token lifecycle state"
        },
        "redeemedByEmail": {
          "type": "string",
          "description": "Google email that redeemed the token"
        },
        "redeemedByUid": {
          "type": "string",
          "description": "Firebase Auth UID that redeemed the token"
        },
        "redeemedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when token was redeemed"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Calculated expiration timestamp when redeemed"
        },
        "createdByUid": {
          "type": "string",
          "description": "Superuser UID that issued the token"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp written via FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp written via FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "tokenCode",
        "assignedUsername",
        "daysGranted",
        "maxDevices",
        "status",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "TeamConfig": {
      "title": "TeamConfig",
      "description": "Singleton team configuration documents such as role_matrix, alerts_feed, knowledge_feed, psa_pricing_sync, and app_version.",
      "type": "object",
      "properties": {
        "configType": {
          "type": "string",
          "enum": ["role_matrix", "alerts_feed", "knowledge_feed", "psa_pricing_sync", "app_version"],
          "description": "Type of team configuration singleton"
        },
        "opPsaEnabled": { "type": "boolean" },
        "opScriptsEnabled": { "type": "boolean" },
        "opAutomationEnabled": { "type": "boolean" },
        "opDashboardEnabled": { "type": "boolean" },
        "opAiSalesEnabled": { "type": "boolean" },
        "opPricingEditEnabled": { "type": "boolean" },
        "suPsaEnabled": { "type": "boolean" },
        "suScriptsEnabled": { "type": "boolean" },
        "suAutomationEnabled": { "type": "boolean" },
        "suDashboardEnabled": { "type": "boolean" },
        "suSuperuserEnabled": { "type": "boolean" },
        "globalLegacyEnabled": { "type": "boolean" },
        "latestVersionCode": {
          "type": "integer",
          "description": "Latest published Android versionCode on server"
        },
        "latestVersionName": {
          "type": "string",
          "description": "Latest published Android versionName on server"
        },
        "apkDownloadUrl": {
          "type": "string",
          "description": "HTTPS URL to download the latest APK"
        },
        "releaseNotes": {
          "type": "string",
          "description": "Optional release notes displayed in the update prompt"
        },
        "forceUpdate": {
          "type": "boolean",
          "description": "Optional global mandatory update enforcement flag (defaults to false for optional notice)"
        },
        "payloadJson": {
          "type": "string",
          "description": "Bounded JSON string for shared team feeds"
        },
        "updatedByUid": {
          "type": "string",
          "description": "UID of the Superuser updating this document"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update"
        }
      },
      "required": ["configType", "updatedByUid", "updatedAt"]
    },
    "PsaContactRecord": {
      "title": "PsaContactRecord",
      "description": "Seller-isolated prospect / lead synced to owner workspace.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "neighborhood": { "type": "string" },
        "notes": { "type": "string" },
        "source": { "type": "string" },
        "callAttemptsCount": { "type": "integer" },
        "messageAttemptsCount": { "type": "integer" },
        "lastContactDateMs": { "type": "integer" },
        "lastContactChannel": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["PENDING", "INTERESTED", "NO_ANSWER", "RESCHEDULED", "APPOINTMENT_SET", "NOT_INTERESTED"]
        },
        "rescheduleDate": { "type": "string" },
        "rescheduleNote": { "type": "string" },
        "createdAtMs": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "ownerUid", "name", "phone", "address", "neighborhood", "notes", "source",
        "callAttemptsCount", "messageAttemptsCount", "lastContactDateMs", "lastContactChannel",
        "status", "rescheduleDate", "rescheduleNote", "createdAtMs", "updatedAt"
      ]
    },
    "PsaVisitRecord": {
      "title": "PsaVisitRecord",
      "description": "Seller-isolated scheduled visit and technical demo diagnostic history.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "neighborhood": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "scheduledTime": { "type": "string" },
        "modelInterest": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["AGENDADA", "CONFIRMADA", "EN_DEMOSTRACION", "CERRADA_EXITO", "REPROGRAMAR", "CANCELADA"]
        },
        "chlorinePpm": { "type": "number" },
        "waterSource": { "type": "string" },
        "hardnessPpm": { "type": "integer" },
        "realLitersPerDay": { "type": "number" },
        "cartSummary": { "type": "string" },
        "soldCartSummary": { "type": "string" },
        "testPhotoPath": { "type": "string" },
        "diagnosticTimestampMs": { "type": "integer" },
        "bottlesPerWeek": { "type": "integer" },
        "quotedPlan": { "type": "string" },
        "notes": { "type": "string" },
        "createdAtMs": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "ownerUid", "customerName", "phone", "address", "neighborhood",
        "scheduledDate", "scheduledTime", "modelInterest", "status", "chlorinePpm",
        "waterSource", "hardnessPpm", "realLitersPerDay", "cartSummary", "soldCartSummary",
        "testPhotoPath", "diagnosticTimestampMs", "bottlesPerWeek", "quotedPlan", "notes",
        "createdAtMs", "updatedAt"
      ]
    },
    "PsaPostSaleRecord": {
      "title": "PsaPostSaleRecord",
      "description": "Seller-isolated after-sales installation and filter replacement cycle reminder.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "contactId": { "type": "string" },
        "visitId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
