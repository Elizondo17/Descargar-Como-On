        "lastActivityLabel": { "type": "string" },
        "recentActivityJson": { "type": "string" },
        "parentEmail": { "type": "string" },
        "supervisorChainEmails": { "type": "array" },
        "hierarchyDepth": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
