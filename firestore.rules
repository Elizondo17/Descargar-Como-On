rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email_verified == true;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function isBootstrapAdmin() {
      return isSignedIn() && authEmail() == 'leonelizondo16@gmail.com';
    }

    function isValidEmailKey(emailKey) {
      return emailKey is string &&
             emailKey.size() >= 5 &&
             emailKey.size() <= 120 &&
             emailKey.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isValidConfigId(configId) {
      return configId is string &&
             configId in ['role_matrix', 'alerts_feed', 'knowledge_feed', 'psa_pricing_sync', 'app_version'] &&
             configId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperuser() {
      return isBootstrapAdmin() ||
             (isSignedIn() &&
              exists(/databases/$(database)/documents/authorized_users/$(authEmail())) &&
              get(/databases/$(database)/documents/authorized_users/$(authEmail())).data.role == 'SUPERUSER' &&
              get(/databases/$(database)/documents/authorized_users/$(authEmail())).data.isBlocked == false);
    }

    function isActiveAuthorizedMember() {
      return isSuperuser() ||
             (isSignedIn() &&
              exists(/databases/$(database)/documents/authorized_users/$(authEmail())) &&
              get(/databases/$(database)/documents/authorized_users/$(authEmail())).data.isBlocked == false &&
              (!('approvalStatus' in get(/databases/$(database)/documents/authorized_users/$(authEmail())).data) ||
               get(/databases/$(database)/documents/authorized_users/$(authEmail())).data.approvalStatus == 'ACTIVE') &&
              get(/databases/$(database)/documents/authorized_users/$(authEmail())).data.expiresAt > request.time &&
              get(/databases/$(database)/documents/authorized_users/$(authEmail())).data.boundDeviceIds.size() > 0);
    }

    function isAuthorizedSubManager() {
      return isSuperuser() ||
             (isActiveAuthorizedMember() &&
              ('canManageSubUsers' in get(/databases/$(database)/documents/authorized_users/$(authEmail())).data) &&
              get(/databases/$(database)/documents/authorized_users/$(authEmail())).data.canManageSubUsers == true);
    }

    function isValidAuthorizedUser(data, emailKey) {
      return data.keys().hasAll([
               'id', 'email', 'username', 'role', 'daysGranted',
               'validFrom', 'expiresAt', 'isBlocked', 'canAccessLegacyModules',
               'notes', 'maxDevices', 'boundDeviceIds', 'boundDeviceLabels',
               'ownerUid', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'email', 'username', 'role', 'daysGranted',
               'validFrom', 'expiresAt', 'isBlocked', 'canAccessLegacyModules',
               'notes', 'maxDevices', 'boundDeviceIds', 'boundDeviceLabels',
               'ownerUid', 'createdAt', 'updatedAt', 'lastTamperAlertAtMs',
               'updateRequired', 'requiredVersionCode', 'updateLockReason',
               'accessToken', 'parentEmail', 'supervisorChainEmails',
               'hierarchyDepth', 'approvalStatus', 'canManageSubUsers',
               'visibilityDepth', 'requestedByEmail', 'tutorialCompleted',
               'fcmToken', 'fcmUpdatedAtMs', 'notifyCatalogUpdates', 'notifyAssignedContacts'
             ]) &&
             data.id is string && data.id.size() >= 3 && data.id.size() <= 80 &&
             data.email is string && data.email == emailKey &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 80 &&
             data.role in ['SUPERUSER', 'OPERATOR'] &&
             data.daysGranted is int && data.daysGranted >= 0 && data.daysGranted <= 3650 &&
             data.validFrom is timestamp && data.validFrom <= request.time &&
             data.expiresAt is timestamp &&
             data.isBlocked is bool &&
             data.canAccessLegacyModules is bool &&
             data.notes is string && data.notes.size() <= 300 &&
             data.maxDevices is int && data.maxDevices >= 1 && data.maxDevices <= 5 &&
             data.boundDeviceIds is list &&
             data.boundDeviceIds.size() <= 5 &&
             (data.boundDeviceIds.size() == 0 || data.boundDeviceIds[0] is string) &&
             data.boundDeviceLabels is list &&
             data.boundDeviceLabels.size() <= 5 &&
             data.boundDeviceLabels.size() == data.boundDeviceIds.size() &&
             (data.boundDeviceLabels.size() == 0 || data.boundDeviceLabels[0] is string) &&
             data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('lastTamperAlertAtMs' in data) || (data.lastTamperAlertAtMs is int && data.lastTamperAlertAtMs >= 0)) &&
             (!('updateRequired' in data) || data.updateRequired is bool) &&
             (!('requiredVersionCode' in data) || (data.requiredVersionCode is int && data.requiredVersionCode >= 0 && data.requiredVersionCode <= 100000)) &&
             (!('updateLockReason' in data) || (data.updateLockReason is string && data.updateLockReason.size() <= 300)) &&
             (!('accessToken' in data) || (data.accessToken is string && data.accessToken.size() <= 64)) &&
             (!('parentEmail' in data) || (data.parentEmail is string && data.parentEmail.size() <= 120)) &&
             (!('supervisorChainEmails' in data) || (data.supervisorChainEmails is list && data.supervisorChainEmails.size() <= 10)) &&
             (!('hierarchyDepth' in data) || (data.hierarchyDepth is int && data.hierarchyDepth >= 0 && data.hierarchyDepth <= 15)) &&
             (!('approvalStatus' in data) || (data.approvalStatus in ['ACTIVE', 'PENDING_APPROVAL', 'REJECTED'])) &&
             (!('canManageSubUsers' in data) || data.canManageSubUsers is bool) &&
             (!('visibilityDepth' in data) || (data.visibilityDepth is int && data.visibilityDepth >= 0 && data.visibilityDepth <= 10)) &&
             (!('requestedByEmail' in data) || (data.requestedByEmail is string && data.requestedByEmail.size() <= 120)) &&
             (!('tutorialCompleted' in data) || data.tutorialCompleted is bool) &&
             (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512)) &&
             (!('fcmUpdatedAtMs' in data) || (data.fcmUpdatedAtMs is int && data.fcmUpdatedAtMs >= 0)) &&
             (!('notifyCatalogUpdates' in data) || data.notifyCatalogUpdates is bool) &&
             (!('notifyAssignedContacts' in data) || data.notifyAssignedContacts is bool);
    }

    function isValidTeamConfig(data, configId) {
      return data.keys().hasAll(['configType', 'updatedByUid', 'updatedAt']) &&
             data.configType is string &&
             data.configType == configId &&
             data.updatedByUid is string &&
             data.updatedByUid == request.auth.uid &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time &&
             (!('opPsaEnabled' in data) || data.opPsaEnabled is bool) &&
             (!('opScriptsEnabled' in data) || data.opScriptsEnabled is bool) &&
             (!('opAutomationEnabled' in data) || data.opAutomationEnabled is bool) &&
             (!('opDashboardEnabled' in data) || data.opDashboardEnabled is bool) &&
             (!('opAiSalesEnabled' in data) || data.opAiSalesEnabled is bool) &&
             (!('opPricingEditEnabled' in data) || data.opPricingEditEnabled is bool) &&
             (!('suPsaEnabled' in data) || data.suPsaEnabled is bool) &&
             (!('suScriptsEnabled' in data) || data.suScriptsEnabled is bool) &&
             (!('suAutomationEnabled' in data) || data.suAutomationEnabled is bool) &&
             (!('suDashboardEnabled' in data) || data.suDashboardEnabled is bool) &&
             (!('suSuperuserEnabled' in data) || data.suSuperuserEnabled is bool) &&
             (!('globalLegacyEnabled' in data) || data.globalLegacyEnabled is bool) &&
             (!('latestVersionCode' in data) || (data.latestVersionCode is int && data.latestVersionCode >= 1 && data.latestVersionCode <= 100000)) &&
             (!('latestVersionName' in data) || (data.latestVersionName is string && data.latestVersionName.size() <= 40)) &&
             (!('apkDownloadUrl' in data) || (data.apkDownloadUrl is string && data.apkDownloadUrl.size() <= 500)) &&
             (!('releaseNotes' in data) || (data.releaseNotes is string && data.releaseNotes.size() <= 1000)) &&
             (!('forceUpdate' in data) || data.forceUpdate is bool) &&
             (!('payloadJson' in data) || (data.payloadJson is string && data.payloadJson.size() <= 200000));
    }

    match /authorized_users/{emailKey} {
      allow get: if isValidEmailKey(emailKey) &&
                    (isSuperuser() ||
                     (isSignedIn() &&
                      (emailKey == authEmail() ||
                       (('supervisorChainEmails' in resource.data) && (authEmail() in resource.data.supervisorChainEmails)))));

      // Zero get()/exists() inside allow list: Bootstrap admin OR ancestor present in supervisorChainEmails
      allow list: if isBootstrapAdmin() ||
                     (isSignedIn() &&
                      ('supervisorChainEmails' in resource.data) &&
                      (authEmail() in resource.data.supervisorChainEmails));

      allow create: if isValidEmailKey(emailKey) &&
                       isValidAuthorizedUser(request.resource.data, emailKey) &&
                       (
                         (isSuperuser() && request.resource.data.role == 'OPERATOR') ||
                         (isBootstrapAdmin() &&
                          emailKey == 'leonelizondo16@gmail.com' &&
                          request.resource.data.role == 'SUPERUSER' &&
                          request.resource.data.ownerUid == request.auth.uid) ||
                         isRedeemingValidToken(request.resource.data, emailKey)
                       );

      allow update: if isValidEmailKey(emailKey) &&
                       isSignedIn() &&
                       (
                         (request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['updateRequired', 'requiredVersionCode', 'updateLockReason', 'isBlocked', 'updatedAt']) &&
                          isSuperuser() &&
                          (!('updateRequired' in request.resource.data) || request.resource.data.updateRequired is bool) &&
                          (!('requiredVersionCode' in request.resource.data) || (request.resource.data.requiredVersionCode is int && request.resource.data.requiredVersionCode >= 0 && request.resource.data.requiredVersionCode <= 100000)) &&
                          (!('updateLockReason' in request.resource.data) || (request.resource.data.updateLockReason is string && request.resource.data.updateLockReason.size() <= 300)) &&
                          (!('isBlocked' in request.resource.data) || request.resource.data.isBlocked is bool) &&
                          request.resource.data.updatedAt is timestamp &&
                          request.resource.data.updatedAt <= request.time) ||
                         (request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['tutorialCompleted', 'updatedAt']) &&
                          request.resource.data.tutorialCompleted is bool &&
                          request.resource.data.updatedAt is timestamp &&
                          request.resource.data.updatedAt <= request.time &&
                          (isSuperuser() ||
                           (emailKey == authEmail() &&
                            resource.data.isBlocked == false &&
                            (!('approvalStatus' in resource.data) || resource.data.approvalStatus == 'ACTIVE') &&
                            resource.data.expiresAt > request.time))) ||
                         (request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['fcmToken', 'fcmUpdatedAtMs', 'notifyCatalogUpdates', 'notifyAssignedContacts', 'updatedAt']) &&
                          (!('fcmToken' in request.resource.data) || (request.resource.data.fcmToken is string && request.resource.data.fcmToken.size() <= 512)) &&
                          (!('fcmUpdatedAtMs' in request.resource.data) || (request.resource.data.fcmUpdatedAtMs is int && request.resource.data.fcmUpdatedAtMs >= 0)) &&
                          (!('notifyCatalogUpdates' in request.resource.data) || request.resource.data.notifyCatalogUpdates is bool) &&
                          (!('notifyAssignedContacts' in request.resource.data) || request.resource.data.notifyAssignedContacts is bool) &&
                          request.resource.data.updatedAt is timestamp &&
                          request.resource.data.updatedAt <= request.time &&
                          (isSuperuser() ||
                           (emailKey == authEmail() &&
                            resource.data.isBlocked == false &&
                            (!('approvalStatus' in resource.data) || resource.data.approvalStatus == 'ACTIVE') &&
                            resource.data.expiresAt > request.time))) ||
                         (
                           (
                             isSuperuser() ||
                             (emailKey == authEmail() &&
                              resource.data.isBlocked == false &&
                              (!('approvalStatus' in resource.data) || resource.data.approvalStatus == 'ACTIVE') &&
                              resource.data.expiresAt > request.time &&
                              request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly([
                                  'boundDeviceIds', 'boundDeviceLabels', 'ownerUid',
                                  'updatedAt', 'lastTamperAlertAtMs',
                                  'updateRequired', 'updateLockReason', 'tutorialCompleted',
                                  'fcmToken', 'fcmUpdatedAtMs', 'notifyCatalogUpdates', 'notifyAssignedContacts'
                                ]) &&
                              (!('updateRequired' in request.resource.data.diff(resource.data).affectedKeys()) ||
                                request.resource.data.updateRequired == false) &&
                              (!('updateLockReason' in request.resource.data.diff(resource.data).affectedKeys()) ||
                                request.resource.data.updateLockReason == '') &&
                              request.resource.data.boundDeviceIds.size() <= resource.data.maxDevices &&
                              request.resource.data.boundDeviceIds.hasAll(resource.data.boundDeviceIds) &&
                              (
                                (resource.data.ownerUid == '' && request.resource.data.ownerUid == request.auth.uid) ||
                                (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid)
                              ))
                           ) &&
                           request.resource.data.email == resource.data.email &&
                           request.resource.data.id == resource.data.id &&
                           request.resource.data.createdAt == resource.data.createdAt &&
                           isValidAuthorizedUser(request.resource.data, emailKey)
                         )
                       );

      allow delete: if isValidEmailKey(emailKey) && isSuperuser() && emailKey != 'leonelizondo16@gmail.com';
    }

    function isOwner(ownerUid) {
      return isSignedIn() &&
             ownerUid is string &&
             ownerUid.size() >= 1 &&
             ownerUid.size() <= 128 &&
             request.auth.uid == ownerUid;
    }

    function isValidSellerContact(data, ownerUid, contactId) {
      return data.keys().hasAll([
               'id', 'ownerUid', 'name', 'phone', 'address', 'neighborhood',
               'notes', 'source', 'callAttemptsCount', 'messageAttemptsCount',
               'lastContactDateMs', 'lastContactChannel', 'status',
               'rescheduleDate', 'rescheduleNote', 'createdAtMs', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerUid', 'name', 'phone', 'address', 'neighborhood',
               'notes', 'source', 'callAttemptsCount', 'messageAttemptsCount',
               'lastContactDateMs', 'lastContactChannel', 'status',
               'rescheduleDate', 'rescheduleNote', 'createdAtMs', 'updatedAt'
             ]) &&
             data.id is string && data.id == contactId && data.id.size() >= 1 && data.id.size() <= 80 &&
             data.ownerUid is string && data.ownerUid == ownerUid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.phone is string && data.phone.size() <= 40 &&
             data.address is string && data.address.size() <= 200 &&
             data.neighborhood is string && data.neighborhood.size() <= 120 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.source is string && data.source.size() <= 60 &&
             data.callAttemptsCount is int && data.callAttemptsCount >= 0 && data.callAttemptsCount <= 10000 &&
             data.messageAttemptsCount is int && data.messageAttemptsCount >= 0 && data.messageAttemptsCount <= 10000 &&
             data.lastContactDateMs is int && data.lastContactDateMs >= 0 &&
             data.lastContactChannel is string && data.lastContactChannel.size() <= 20 &&
             data.status in ['PENDING', 'INTERESTED', 'NO_ANSWER', 'RESCHEDULED', 'APPOINTMENT_SET', 'NOT_INTERESTED'] &&
             data.rescheduleDate is string && data.rescheduleDate.size() <= 20 &&
             data.rescheduleNote is string && data.rescheduleNote.size() <= 300 &&
             data.createdAtMs is int && data.createdAtMs >= 0 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSellerVisit(data, ownerUid, visitId) {
      return data.keys().hasAll([
               'id', 'ownerUid', 'customerName', 'phone', 'address', 'neighborhood',
               'scheduledDate', 'scheduledTime', 'modelInterest', 'status', 'chlorinePpm',
               'waterSource', 'hardnessPpm', 'realLitersPerDay', 'cartSummary', 'soldCartSummary',
               'testPhotoPath', 'diagnosticTimestampMs', 'bottlesPerWeek', 'quotedPlan',
               'notes', 'createdAtMs', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerUid', 'customerName', 'phone', 'address', 'neighborhood',
               'scheduledDate', 'scheduledTime', 'modelInterest', 'status', 'chlorinePpm',
               'waterSource', 'hardnessPpm', 'realLitersPerDay', 'cartSummary', 'soldCartSummary',
               'testPhotoPath', 'diagnosticTimestampMs', 'bottlesPerWeek', 'quotedPlan',
               'notes', 'createdAtMs', 'updatedAt'
             ]) &&
             data.id is string && data.id == visitId && data.id.size() >= 1 && data.id.size() <= 80 &&
             data.ownerUid is string && data.ownerUid == ownerUid &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
             data.phone is string && data.phone.size() <= 40 &&
             data.address is string && data.address.size() <= 200 &&
             data.neighborhood is string && data.neighborhood.size() <= 120 &&
             data.scheduledDate is string && data.scheduledDate.size() <= 20 &&
             data.scheduledTime is string && data.scheduledTime.size() <= 16 &&
             data.modelInterest is string && data.modelInterest.size() <= 120 &&
             data.status in ['AGENDADA', 'CONFIRMADA', 'EN_DEMOSTRACION', 'CERRADA_EXITO', 'REPROGRAMAR', 'CANCELADA'] &&
             data.chlorinePpm is number && data.chlorinePpm >= 0 && data.chlorinePpm <= 10 &&
             data.waterSource is string && data.waterSource.size() <= 40 &&
             data.hardnessPpm is int && data.hardnessPpm >= 0 && data.hardnessPpm <= 2000 &&
             data.realLitersPerDay is number && data.realLitersPerDay >= 0 && data.realLitersPerDay <= 500 &&
             data.cartSummary is string && data.cartSummary.size() <= 500 &&
             data.soldCartSummary is string && data.soldCartSummary.size() <= 500 &&
             data.testPhotoPath is string && data.testPhotoPath.size() <= 400 &&
             data.diagnosticTimestampMs is int && data.diagnosticTimestampMs >= 0 &&
             data.bottlesPerWeek is int && data.bottlesPerWeek >= 0 && data.bottlesPerWeek <= 500 &&
             data.quotedPlan is string && data.quotedPlan.size() <= 400 &&
             data.notes is string && data.notes.size() <= 600 &&
             data.createdAtMs is int && data.createdAtMs >= 0 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPostSaleRecord(data, ownerUid, recordId) {
      return data.keys().hasAll([
               'id', 'ownerUid', 'contactId', 'visitId', 'customerName', 'customerPhone',
               'purifierId', 'purifierName', 'installedAtMs', 'replacementCycleMonths',
               'nextReplacementAtMs', 'lastNotifiedDayKey', 'status', 'notes',
               'createdAtMs', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerUid', 'contactId', 'visitId', 'customerName', 'customerPhone',
               'purifierId', 'purifierName', 'installedAtMs', 'replacementCycleMonths',
               'nextReplacementAtMs', 'lastNotifiedDayKey', 'status', 'notes',
               'createdAtMs', 'updatedAt'
             ]) &&
             data.id is string && data.id == recordId && data.id.size() >= 1 && data.id.size() <= 80 &&
             data.ownerUid is string && data.ownerUid == ownerUid &&
             data.contactId is string && data.contactId.size() <= 80 &&
             data.visitId is string && data.visitId.size() <= 80 &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
             data.customerPhone is string && data.customerPhone.size() <= 40 &&
             data.purifierId is string && data.purifierId.size() >= 1 && data.purifierId.size() <= 80 &&
             data.purifierName is string && data.purifierName.size() >= 1 && data.purifierName.size() <= 160 &&
             data.installedAtMs is int && data.installedAtMs >= 0 &&
             data.replacementCycleMonths in [6, 12, 24, 36] &&
             data.nextReplacementAtMs is int && data.nextReplacementAtMs >= 0 &&
             data.lastNotifiedDayKey is string && data.lastNotifiedDayKey.size() <= 20 &&
             data.status in ['ACTIVO', 'ATENDIDO'] &&
             data.notes is string && data.notes.size() <= 400 &&
             data.createdAtMs is int && data.createdAtMs >= 0 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBusinessInvite(data, ownerUid, inviteId) {
      return data.keys().hasAll([
               'id', 'ownerUid', 'sellerEmail', 'name', 'phone', 'email',
               'notes', 'status', 'presentationDate', 'presentationTime',
               'reminderEnabled', 'reminderAtMs', 'whatsappSentCount',
               'linkedRequestId', 'createdAtMs', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerUid', 'sellerEmail', 'name', 'phone', 'email',
               'notes', 'status', 'presentationDate', 'presentationTime',
               'reminderEnabled', 'reminderAtMs', 'whatsappSentCount',
               'linkedRequestId', 'createdAtMs', 'updatedAt'
             ]) &&
             data.id is string && data.id == inviteId && data.id.size() >= 1 && data.id.size() <= 80 &&
             data.ownerUid is string && data.ownerUid == ownerUid &&
             data.sellerEmail is string && data.sellerEmail.size() <= 120 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.phone is string && data.phone.size() <= 40 &&
             data.email is string && data.email.size() <= 120 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.status in ['INVITED', 'CONFIRMED', 'ATTENDED', 'JOINED_TEAM', 'NOT_INTERESTED'] &&
             data.presentationDate is string && data.presentationDate.size() <= 20 &&
             data.presentationTime is string && data.presentationTime.size() <= 16 &&
             data.reminderEnabled is bool &&
             data.reminderAtMs is int && data.reminderAtMs >= 0 &&
             data.whatsappSentCount is int && data.whatsappSentCount >= 0 && data.whatsappSentCount <= 10000 &&
             data.linkedRequestId is string && data.linkedRequestId.size() <= 80 &&
             data.createdAtMs is int && data.createdAtMs >= 0 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSellerStats(data, ownerUid) {
      return data.keys().hasAll([
               'ownerUid', 'sellerName', 'sellerEmail', 'totalContacts', 'totalVisits',
               'completedDemos', 'closedSales', 'pendingReplacements', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'ownerUid', 'sellerName', 'sellerEmail', 'totalContacts', 'totalVisits',
               'completedDemos', 'closedSales', 'pendingReplacements',
               'messagesSuccess', 'messagesFailed', 'messagesTotal',
               'callsAttempted', 'callsConnected', 'lastMessageAtMs',
               'lastActivityAtMs', 'lastActivityLabel', 'recentActivityJson',
               'parentEmail', 'supervisorChainEmails', 'hierarchyDepth',
               'updatedAt'
             ]) &&
             data.ownerUid is string && data.ownerUid == ownerUid &&
             data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80 &&
             data.sellerEmail is string && data.sellerEmail.size() >= 5 && data.sellerEmail.size() <= 120 &&
             data.totalContacts is int && data.totalContacts >= 0 && data.totalContacts <= 100000 &&
             data.totalVisits is int && data.totalVisits >= 0 && data.totalVisits <= 100000 &&
             data.completedDemos is int && data.completedDemos >= 0 && data.completedDemos <= 100000 &&
             data.closedSales is int && data.closedSales >= 0 && data.closedSales <= 100000 &&
             data.pendingReplacements is int && data.pendingReplacements >= 0 && data.pendingReplacements <= 100000 &&
             (!('messagesSuccess' in data) || (data.messagesSuccess is int && data.messagesSuccess >= 0 && data.messagesSuccess <= 1000000)) &&
             (!('messagesFailed' in data) || (data.messagesFailed is int && data.messagesFailed >= 0 && data.messagesFailed <= 1000000)) &&
             (!('messagesTotal' in data) || (data.messagesTotal is int && data.messagesTotal >= 0 && data.messagesTotal <= 1000000)) &&
             (!('callsAttempted' in data) || (data.callsAttempted is int && data.callsAttempted >= 0 && data.callsAttempted <= 1000000)) &&
             (!('callsConnected' in data) || (data.callsConnected is int && data.callsConnected >= 0 && data.callsConnected <= 1000000)) &&
             (!('lastMessageAtMs' in data) || (data.lastMessageAtMs is int && data.lastMessageAtMs >= 0)) &&
             (!('lastActivityAtMs' in data) || (data.lastActivityAtMs is int && data.lastActivityAtMs >= 0)) &&
             (!('lastActivityLabel' in data) || (data.lastActivityLabel is string && data.lastActivityLabel.size() <= 160)) &&
             (!('recentActivityJson' in data) || (data.recentActivityJson is string && data.recentActivityJson.size() <= 10000)) &&
             (!('parentEmail' in data) || (data.parentEmail is string && data.parentEmail.size() <= 120)) &&
             (!('supervisorChainEmails' in data) || (data.supervisorChainEmails is list && data.supervisorChainEmails.size() <= 10)) &&
             (!('hierarchyDepth' in data) || (data.hierarchyDepth is int && data.hierarchyDepth >= 0 && data.hierarchyDepth <= 15)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /team_config/{configId} {
      allow get: if isValidConfigId(configId) &&
                    (isActiveAuthorizedMember() || (configId == 'app_version' && isSignedIn()));
      allow list: if isBootstrapAdmin();
      allow create, update: if isValidConfigId(configId) &&
                               isSuperuser() &&
                               isValidTeamConfig(request.resource.data, configId);
      allow delete: if isValidConfigId(configId) && isBootstrapAdmin();
    }

    match /seller_workspaces/{ownerUid} {
      match /contacts/{contactId} {
        allow get, list: if isOwner(ownerUid);
        allow create: if isOwner(ownerUid) && isValidSellerContact(request.resource.data, ownerUid, contactId);
        allow update: if isOwner(ownerUid) &&
                         isValidSellerContact(request.resource.data, ownerUid, contactId) &&
                         request.resource.data.ownerUid == resource.data.ownerUid &&
                         request.resource.data.id == resource.data.id;
        allow delete: if isOwner(ownerUid);
      }

      match /visits/{visitId} {
        allow get, list: if isOwner(ownerUid);
        allow create: if isOwner(ownerUid) && isValidSellerVisit(request.resource.data, ownerUid, visitId);
        allow update: if isOwner(ownerUid) &&
                         isValidSellerVisit(request.resource.data, ownerUid, visitId) &&
                         request.resource.data.ownerUid == resource.data.ownerUid &&
                         request.resource.data.id == resource.data.id;
        allow delete: if isOwner(ownerUid);
      }

      match /post_sale/{recordId} {
        allow get, list: if isOwner(ownerUid);
        allow create: if isOwner(ownerUid) && isValidPostSaleRecord(request.resource.data, ownerUid, recordId);
        allow update: if isOwner(ownerUid) &&
                         isValidPostSaleRecord(request.resource.data, ownerUid, recordId) &&
                         request.resource.data.ownerUid == resource.data.ownerUid &&
                         request.resource.data.id == resource.data.id;
        allow delete: if isOwner(ownerUid);
      }

      match /business_invites/{inviteId} {
        allow get, list: if isOwner(ownerUid);
        allow create: if isOwner(ownerUid) && isValidBusinessInvite(request.resource.data, ownerUid, inviteId);
        allow update: if isOwner(ownerUid) &&
                         isValidBusinessInvite(request.resource.data, ownerUid, inviteId) &&
                         request.resource.data.ownerUid == resource.data.ownerUid &&
                         request.resource.data.id == resource.data.id;
        allow delete: if isOwner(ownerUid);
      }
    }

    match /seller_stats/{ownerUid} {
      allow get: if isOwner(ownerUid) ||
                    isBootstrapAdmin() ||
                    (isSignedIn() &&
                     ('supervisorChainEmails' in resource.data) &&
                     (authEmail() in resource.data.supervisorChainEmails));
      allow list: if isBootstrapAdmin() ||
                     (isSignedIn() &&
                      ('supervisorChainEmails' in resource.data) &&
                      (authEmail() in resource.data.supervisorChainEmails));
      allow create: if isOwner(ownerUid) && isValidSellerStats(request.resource.data, ownerUid);
      allow update: if isValidSellerStats(request.resource.data, ownerUid) &&
                       request.resource.data.ownerUid == resource.data.ownerUid &&
                       (
                         isOwner(ownerUid) ||
                         (isSuperuser() &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['parentEmail', 'supervisorChainEmails', 'hierarchyDepth', 'updatedAt']))
                       );
      allow delete: if isBootstrapAdmin();
    }

    function isValidErrorId(errorId) {
      return errorId is string &&
             errorId.size() >= 3 &&
             errorId.size() <= 80 &&
             errorId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAppError(data, errorId) {
      return data.keys().hasAll([
               'id', 'ownerUid', 'reporterEmail', 'reporterName', 'stage',
               'errorMessage', 'stackTraceExcerpt', 'logcatExcerpt',
               'deviceModel', 'androidSdk', 'appVersionName', 'appVersionCode',
               'status', 'occurredAtMs', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerUid', 'reporterEmail', 'reporterName', 'stage',
               'errorMessage', 'stackTraceExcerpt', 'logcatExcerpt',
               'deviceModel', 'androidSdk', 'appVersionName', 'appVersionCode',
               'status', 'occurredAtMs', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id == errorId &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.reporterEmail is string && data.reporterEmail.size() <= 120 &&
             data.reporterName is string && data.reporterName.size() <= 80 &&
             data.stage in ['ON_CREATE', 'LOGCAT_FIREBASE'] &&
             data.errorMessage is string && data.errorMessage.size() >= 1 && data.errorMessage.size() <= 600 &&
             data.stackTraceExcerpt is string && data.stackTraceExcerpt.size() <= 2500 &&
             data.logcatExcerpt is string && data.logcatExcerpt.size() <= 3000 &&
             data.deviceModel is string && data.deviceModel.size() <= 100 &&
             data.androidSdk is int && data.androidSdk >= 21 && data.androidSdk <= 60 &&
             data.appVersionName is string && data.appVersionName.size() <= 40 &&
             data.appVersionCode is int && data.appVersionCode >= 1 && data.appVersionCode <= 100000 &&
             data.status in ['OPEN', 'RESOLVED'] &&
             data.occurredAtMs is int && data.occurredAtMs >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /AppErrors/{errorId} {
      allow get: if isValidErrorId(errorId) &&
                    (isSuperuser() || (isSignedIn() && resource.data.ownerUid == request.auth.uid));
      // Only bootstrap admin lists AppErrors so allow list stays free of get()/exists() calls
      allow list: if isBootstrapAdmin();
      allow create: if isValidErrorId(errorId) &&
                       isSignedIn() &&
                       isValidAppError(request.resource.data, errorId) &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       request.resource.data.status == 'OPEN';
      allow update: if errorId is string &&
                       errorId.size() >= 1 &&
                       errorId.size() <= 128 &&
                       isSuperuser() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       request.resource.data.status in ['OPEN', 'RESOLVED'] &&
                       request.resource.data.updatedAt is timestamp &&
                       request.resource.data.updatedAt <= request.time;
      allow delete: if errorId is string &&
                       errorId.size() >= 1 &&
                       errorId.size() <= 128 &&
                       isSuperuser();
    }

    function isValidTokenCode(tokenCode) {
      return tokenCode is string &&
             tokenCode.size() >= 6 &&
             tokenCode.size() <= 40 &&
             tokenCode.matches('^[A-Z0-9_\\-]+$');
    }

    function isValidAccessToken(data, tokenCode) {
      return data.keys().hasAll([
               'tokenCode', 'assignedUsername', 'daysGranted', 'maxDevices',
               'status', 'createdByUid', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'tokenCode', 'assignedUsername', 'targetEmail', 'daysGranted',
               'maxDevices', 'notes', 'status', 'redeemedByEmail', 'redeemedByUid',
               'redeemedAt', 'expiresAt', 'createdByUid', 'createdAt', 'updatedAt'
             ]) &&
             data.tokenCode is string && data.tokenCode == tokenCode &&
             data.assignedUsername is string && data.assignedUsername.size() >= 1 && data.assignedUsername.size() <= 80 &&
             (!('targetEmail' in data) || (data.targetEmail is string && data.targetEmail.size() <= 120)) &&
             data.daysGranted is int && data.daysGranted >= 1 && data.daysGranted <= 3650 &&
             data.maxDevices is int && data.maxDevices >= 1 && data.maxDevices <= 5 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
             data.status in ['AVAILABLE', 'REDEEMED', 'REVOKED'] &&
             (!('redeemedByEmail' in data) || (data.redeemedByEmail is string && data.redeemedByEmail.size() <= 120)) &&
             (!('redeemedByUid' in data) || (data.redeemedByUid is string && data.redeemedByUid.size() <= 128)) &&
             (!('redeemedAt' in data) || (data.redeemedAt is timestamp && data.redeemedAt <= request.time)) &&
             (!('expiresAt' in data) || (data.expiresAt is timestamp)) &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isRedeemingValidToken(userData, emailKey) {
      return isSignedIn() &&
             emailKey == authEmail() &&
             userData.role == 'OPERATOR' &&
             userData.isBlocked == false &&
             userData.canAccessLegacyModules == false &&
             (!('canManageSubUsers' in userData) || userData.canManageSubUsers == false) &&
             (!('approvalStatus' in userData) || userData.approvalStatus == 'ACTIVE') &&
             userData.ownerUid == request.auth.uid &&
             userData.boundDeviceIds.size() == 1 &&
             ('accessToken' in userData) &&
             isValidTokenCode(userData.accessToken) &&
             exists(/databases/$(database)/documents/access_tokens/$(userData.accessToken)) &&
             get(/databases/$(database)/documents/access_tokens/$(userData.accessToken)).data.status == 'AVAILABLE' &&
             (!('targetEmail' in get(/databases/$(database)/documents/access_tokens/$(userData.accessToken)).data) ||
              get(/databases/$(database)/documents/access_tokens/$(userData.accessToken)).data.targetEmail == '' ||
              get(/databases/$(database)/documents/access_tokens/$(userData.accessToken)).data.targetEmail == emailKey) &&
             userData.daysGranted == get(/databases/$(database)/documents/access_tokens/$(userData.accessToken)).data.daysGranted &&
             userData.maxDevices == get(/databases/$(database)/documents/access_tokens/$(userData.accessToken)).data.maxDevices &&
             userData.expiresAt > request.time &&
             userData.expiresAt <= request.time + duration.value(userData.daysGranted * 86400 + 3600, 's') &&
             getAfter(/databases/$(database)/documents/access_tokens/$(userData.accessToken)).data.status == 'REDEEMED' &&
             getAfter(/databases/$(database)/documents/access_tokens/$(userData.accessToken)).data.redeemedByEmail == emailKey &&
             getAfter(/databases/$(database)/documents/access_tokens/$(userData.accessToken)).data.redeemedByUid == request.auth.uid;
    }

    match /access_tokens/{tokenCode} {
      allow get: if isValidTokenCode(tokenCode) &&
                    (
                      isSuperuser() ||
                      (isSignedIn() && (
                        resource == null ||
                        resource.data.status == 'AVAILABLE' ||
                        resource.data.redeemedByEmail == authEmail() ||
                        (('targetEmail' in resource.data) && resource.data.targetEmail == authEmail())
                      ))
                    );

      // Only bootstrap admin lists access_tokens so allow list contains zero get()/exists() calls
      allow list: if isBootstrapAdmin();

      allow create: if isValidTokenCode(tokenCode) &&
                       isSuperuser() &&
                       isValidAccessToken(request.resource.data, tokenCode) &&
                       request.resource.data.status == 'AVAILABLE' &&
                       request.resource.data.createdByUid == request.auth.uid;

      allow update: if isValidTokenCode(tokenCode) &&
                       isValidAccessToken(request.resource.data, tokenCode) &&
                       request.resource.data.tokenCode == resource.data.tokenCode &&
                       request.resource.data.createdByUid == resource.data.createdByUid &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       (
                         isSuperuser() ||
                         (
                           isSignedIn() &&
                           resource.data.status == 'AVAILABLE' &&
                           (!('targetEmail' in resource.data) ||
                            resource.data.targetEmail == '' ||
                            resource.data.targetEmail == authEmail()) &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'redeemedByEmail', 'redeemedByUid', 'redeemedAt', 'expiresAt', 'updatedAt']) &&
                           request.resource.data.status == 'REDEEMED' &&
                           request.resource.data.redeemedByEmail == authEmail() &&
                           request.resource.data.redeemedByUid == request.auth.uid &&
                           request.resource.data.redeemedAt is timestamp &&
                           request.resource.data.redeemedAt <= request.time &&
                           request.resource.data.expiresAt is timestamp &&
                           request.resource.data.expiresAt > request.time &&
                           request.resource.data.expiresAt <= request.time + duration.value(resource.data.daysGranted * 86400 + 3600, 's') &&
                           existsAfter(/databases/$(database)/documents/authorized_users/$(authEmail()))
                         )
                       );

      allow delete: if isValidTokenCode(tokenCode) && isSuperuser();
    }

    function isValidHierarchyRequestId(requestId) {
      return requestId is string &&
             requestId.size() >= 3 &&
             requestId.size() <= 80 &&
             requestId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHierarchyRequest(data, requestId) {
      return data.keys().hasAll([
               'id', 'requestType', 'requestedParentEmail', 'requestedParentName',
               'targetEmail', 'targetUsername', 'suggestedDays', 'maxDevices',
               'notes', 'requestedByUid', 'requestedByEmail', 'status',
               'resolvedByEmail', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'requestType', 'requestedParentEmail', 'requestedParentName',
               'targetEmail', 'targetUsername', 'suggestedDays', 'maxDevices',
               'notes', 'requestedByUid', 'requestedByEmail', 'status',
               'resolvedByEmail', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id == requestId &&
             data.requestType in ['NEW_SUB_USER', 'LINK_EXISTING_USER'] &&
             data.requestedParentEmail is string && isValidEmailKey(data.requestedParentEmail) &&
             data.requestedParentName is string && data.requestedParentName.size() <= 80 &&
             data.targetEmail is string && isValidEmailKey(data.targetEmail) &&
             data.targetEmail != data.requestedParentEmail &&
             data.targetUsername is string && data.targetUsername.size() >= 1 && data.targetUsername.size() <= 80 &&
             data.suggestedDays is int && data.suggestedDays >= 1 && data.suggestedDays <= 3650 &&
             data.maxDevices is int && data.maxDevices >= 1 && data.maxDevices <= 5 &&
             data.notes is string && data.notes.size() <= 300 &&
             data.requestedByUid is string && data.requestedByUid.size() >= 1 && data.requestedByUid.size() <= 128 &&
             data.requestedByEmail is string && isValidEmailKey(data.requestedByEmail) &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             data.resolvedByEmail is string && data.resolvedByEmail.size() <= 120 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /hierarchy_requests/{requestId} {
      allow get: if isValidHierarchyRequestId(requestId) &&
                    (
                      isSuperuser() ||
                      (isSignedIn() && (
                        resource.data.requestedByUid == request.auth.uid ||
                        resource.data.requestedByEmail == authEmail() ||
                        resource.data.targetEmail == authEmail()
                      ))
                    );

      // Zero get()/exists() in allow list: Bootstrap admin OR requests submitted by the signed-in manager
      allow list: if isBootstrapAdmin() ||
                     (isSignedIn() && resource.data.requestedByEmail == authEmail());

      allow create: if isValidHierarchyRequestId(requestId) &&
                       isValidHierarchyRequest(request.resource.data, requestId) &&
                       request.resource.data.status == 'PENDING' &&
                       request.resource.data.requestedByUid == request.auth.uid &&
                       request.resource.data.requestedByEmail == authEmail() &&
                       request.resource.data.resolvedByEmail == '' &&
                       (
                         isSuperuser() ||
                         (request.resource.data.requestedParentEmail == authEmail() &&
                          ((request.resource.data.requestType == 'NEW_SUB_USER' && isActiveAuthorizedMember()) ||
                           (request.resource.data.requestType == 'LINK_EXISTING_USER' && isAuthorizedSubManager())))
                       );

      allow update: if isValidHierarchyRequestId(requestId) &&
                       isSuperuser() &&
                       isValidHierarchyRequest(request.resource.data, requestId) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.requestType == resource.data.requestType &&
                       request.resource.data.requestedByUid == resource.data.requestedByUid &&
                       request.resource.data.requestedByEmail == resource.data.requestedByEmail &&
                       request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isValidHierarchyRequestId(requestId) &&
                       (
                         isSuperuser() ||
                         (isSignedIn() &&
                          resource.data.requestedByEmail == authEmail() &&
                          resource.data.status == 'PENDING')
                       );
    }

    function isValidNotificationId(notifId) {
      return notifId is string &&
             notifId.size() >= 3 &&
             notifId.size() <= 80 &&
             notifId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTeamNotification(data, notifId) {
      return data.keys().hasAll([
               'id', 'type', 'priority', 'targetMode', 'targetEmail',
               'senderEmail', 'senderName', 'senderUid', 'title', 'body',
               'createdAtMs', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'type', 'priority', 'targetMode', 'targetEmail',
               'senderEmail', 'senderName', 'senderUid', 'title', 'body',
               'actionUrl', 'requiredVersionCode', 'createdAtMs', 'createdAt'
             ]) &&
             data.id is string && data.id == notifId &&
             data.type in ['APP_UPDATE', 'SUPERUSER_GLOBAL', 'SUPERUSER_DIRECT', 'LEADER_COACHING', 'CATALOG_UPDATE', 'ASSIGNED_CONTACT'] &&
             data.priority in ['INFO', 'IMPORTANT', 'URGENT'] &&
             data.targetMode in ['ALL', 'USER'] &&
             data.targetEmail is string && data.targetEmail.size() <= 120 &&
             ((data.targetMode == 'ALL' && data.targetEmail == '') ||
              (data.targetMode == 'USER' && isValidEmailKey(data.targetEmail))) &&
             data.senderEmail is string && isValidEmailKey(data.senderEmail) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
             (!('actionUrl' in data) || (data.actionUrl is string && data.actionUrl.size() <= 500)) &&
             (!('requiredVersionCode' in data) || (data.requiredVersionCode is int && data.requiredVersionCode >= 0 && data.requiredVersionCode <= 100000)) &&
             data.createdAtMs is int && data.createdAtMs >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /team_notifications/{notifId} {
      allow get: if isValidNotificationId(notifId) &&
                    (
                      isSuperuser() ||
                      (isSignedIn() && (
                        resource.data.targetMode == 'ALL' ||
                        resource.data.targetEmail == authEmail() ||
                        resource.data.senderEmail == authEmail()
                      ))
                    );

      // Zero get()/exists() inside allow list: bootstrap admin or scoped to global/recipient/sender
      allow list: if isBootstrapAdmin() ||
                     (isSignedIn() && (
                       resource.data.targetMode == 'ALL' ||
                       resource.data.targetEmail == authEmail() ||
                       resource.data.senderEmail == authEmail()
                     ));

      allow create: if isValidNotificationId(notifId) &&
                       isValidTeamNotification(request.resource.data, notifId) &&
                       request.resource.data.senderEmail == authEmail() &&
                       request.resource.data.senderUid == request.auth.uid &&
                       (
                         isSuperuser() ||
                         (
                           request.resource.data.type == 'LEADER_COACHING' &&
                           request.resource.data.targetMode == 'USER' &&
                           isAuthorizedSubManager() &&
                           exists(/databases/$(database)/documents/authorized_users/$(request.resource.data.targetEmail)) &&
                           ('supervisorChainEmails' in get(/databases/$(database)/documents/authorized_users/$(request.resource.data.targetEmail)).data) &&
                           (authEmail() in get(/databases/$(database)/documents/authorized_users/$(request.resource.data.targetEmail)).data.supervisorChainEmails)
                         )
                       );

      allow update, delete: if isValidNotificationId(notifId) && isSuperuser();
    }

    function isValidMensajeId(mensajeId) {
      return mensajeId is string &&
             mensajeId.size() >= 3 &&
             mensajeId.size() <= 80 &&
             mensajeId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMensajeGlobal(data) {
      return data.keys().hasAll([
               'titulo', 'mensaje', 'prioridad', 'activo',
               'autorEmail', 'autorNombre', 'autorUid', 'creadoEnMs',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'titulo', 'mensaje', 'prioridad', 'activo',
               'autorEmail', 'autorNombre', 'autorUid', 'creadoEnMs',
               'createdAt', 'updatedAt'
             ]) &&
             data.titulo is string && data.titulo.size() >= 1 && data.titulo.size() <= 120 &&
             data.mensaje is string && data.mensaje.size() >= 1 && data.mensaje.size() <= 1000 &&
             data.prioridad in ['INFO', 'IMPORTANTE', 'URGENTE'] &&
             data.activo is bool &&
             data.autorEmail is string && isValidEmailKey(data.autorEmail) &&
             data.autorNombre is string && data.autorNombre.size() >= 1 && data.autorNombre.size() <= 80 &&
             data.autorUid is string && data.autorUid.size() >= 1 && data.autorUid.size() <= 128 &&
             data.creadoEnMs is int && data.creadoEnMs >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /mensajes_globales/{mensajeId} {
      allow get: if isValidMensajeId(mensajeId) &&
                    (isSuperuser() || (isSignedIn() && resource.data.activo == true));

      // Zero get()/exists() inside allow list: Bootstrap admin or active global announcements
      allow list: if isBootstrapAdmin() ||
                     (isSignedIn() && resource.data.activo == true);

      allow create: if isValidMensajeId(mensajeId) &&
                       isSuperuser() &&
                       isValidMensajeGlobal(request.resource.data) &&
                       request.resource.data.autorEmail == authEmail() &&
                       request.resource.data.autorUid == request.auth.uid;

      allow update: if isValidMensajeId(mensajeId) &&
                       isSuperuser() &&
                       (
                         (request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['activo', 'updatedAt']) &&
                          request.resource.data.activo is bool &&
                          request.resource.data.updatedAt is timestamp &&
                          request.resource.data.updatedAt <= request.time) ||
                         (isValidMensajeGlobal(request.resource.data) &&
                          request.resource.data.autorEmail == resource.data.autorEmail &&
                          request.resource.data.autorUid == resource.data.autorUid &&
                          request.resource.data.createdAt == resource.data.createdAt)
                       );

      allow delete: if isValidMensajeId(mensajeId) && isSuperuser();
    }

    function isValidFcmDispatchId(dispatchId) {
      return dispatchId is string &&
             dispatchId.size() >= 3 &&
             dispatchId.size() <= 80 &&
             dispatchId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFcmDispatch(data, dispatchId) {
      return data.keys().hasAll([
               'id', 'category', 'targetMode', 'targetTopic', 'targetToken',
               'targetEmail', 'title', 'body', 'priority', 'senderEmail',
               'senderName', 'senderUid', 'status', 'createdAtMs', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'category', 'targetMode', 'targetTopic', 'targetToken',
               'targetEmail', 'title', 'body', 'priority', 'actionUrl',
               'senderEmail', 'senderName', 'senderUid', 'status',
               'createdAtMs', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id == dispatchId &&
             data.category in ['CATALOG_UPDATE', 'ASSIGNED_CONTACT', 'SUPERUSER_GLOBAL', 'SUPERUSER_DIRECT', 'LEADER_COACHING', 'APP_UPDATE'] &&
             data.targetMode in ['TOPIC', 'TOKEN'] &&
             data.targetTopic is string && data.targetTopic.size() <= 80 &&
             data.targetToken is string && data.targetToken.size() <= 512 &&
             data.targetEmail is string && data.targetEmail.size() <= 120 &&
             ((data.targetMode == 'TOPIC' && data.targetTopic.size() >= 3 && data.targetToken == '') ||
              (data.targetMode == 'TOKEN' && data.targetToken.size() >= 10 && data.targetTopic == '' && isValidEmailKey(data.targetEmail))) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
             data.priority in ['INFO', 'IMPORTANT', 'URGENT'] &&
             (!('actionUrl' in data) || (data.actionUrl is string && data.actionUrl.size() <= 500)) &&
             data.senderEmail is string && isValidEmailKey(data.senderEmail) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.status in ['QUEUED', 'SENT', 'FAILED'] &&
             data.createdAtMs is int && data.createdAtMs >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /fcm_dispatch_queue/{dispatchId} {
      allow get: if isValidFcmDispatchId(dispatchId) &&
                    (
                      isSuperuser() ||
                      (isSignedIn() && (
                        resource.data.senderEmail == authEmail() ||
                        resource.data.targetEmail == authEmail()
                      ))
                    );

      allow list: if isBootstrapAdmin() ||
                     (isSignedIn() && (
                       resource.data.senderEmail == authEmail() ||
                       resource.data.targetEmail == authEmail()
                     ));

      allow create: if isValidFcmDispatchId(dispatchId) &&
                       isValidFcmDispatch(request.resource.data, dispatchId) &&
                       request.resource.data.status == 'QUEUED' &&
                       request.resource.data.senderEmail == authEmail() &&
                       request.resource.data.senderUid == request.auth.uid &&
                       (
                         isSuperuser() ||
                         (
                           request.resource.data.category == 'LEADER_COACHING' &&
                           request.resource.data.targetEmail != '' &&
                           isAuthorizedSubManager() &&
                           exists(/databases/$(database)/documents/authorized_users/$(request.resource.data.targetEmail)) &&
                           ('supervisorChainEmails' in get(/databases/$(database)/documents/authorized_users/$(request.resource.data.targetEmail)).data) &&
                           (authEmail() in get(/databases/$(database)/documents/authorized_users/$(request.resource.data.targetEmail)).data.supervisorChainEmails)
                         )
                       );

      allow update, delete: if isValidFcmDispatchId(dispatchId) && isSuperuser();
    }
  }
}
