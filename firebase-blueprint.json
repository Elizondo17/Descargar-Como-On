        "purifierName": { "type": "string" },
        "installedAtMs": { "type": "integer" },
        "replacementCycleMonths": { "type": "integer", "enum": [6, 12, 24, 36] },
        "nextReplacementAtMs": { "type": "integer" },
        "lastNotifiedDayKey": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVO", "ATENDIDO"] },
        "notes": { "type": "string" },
        "createdAtMs": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "ownerUid", "contactId", "visitId", "customerName", "customerPhone",
        "purifierId", "purifierName", "installedAtMs", "replacementCycleMonths",
        "nextReplacementAtMs", "lastNotifiedDayKey", "status", "notes", "createdAtMs", "updatedAt"
      ]
    },
