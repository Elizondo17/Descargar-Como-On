    "FcmDispatchQueueItem": {
      "title": "FcmDispatchQueueItem",
      "description": "Push notification dispatch request queued for Firebase Cloud Functions / FCM delivery.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["CATALOG_UPDATE", "ASSIGNED_CONTACT", "SUPERUSER_GLOBAL", "SUPERUSER_DIRECT", "LEADER_COACHING", "APP_UPDATE"]
        },
        "targetMode": { "type": "string", "enum": ["TOPIC", "TOKEN"] },
        "targetTopic": { "type": "string" },
        "targetToken": { "type": "string" },
        "targetEmail": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "priority": { "type": "string", "enum": ["INFO", "IMPORTANT", "URGENT"] },
        "actionUrl": { "type": "string" },
        "senderEmail": { "type": "string" },
        "senderName": { "type": "string" },
        "senderUid": { "type": "string" },
        "status": { "type": "string", "enum": ["QUEUED", "SENT", "FAILED"] },
        "createdAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "category", "targetMode", "targetTopic", "targetToken", "targetEmail",
        "title", "body", "priority", "senderEmail", "senderName", "senderUid",
        "status", "createdAtMs", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/authorized_users/{emailKey}": {
      "schema": { "$ref": "#/entities/AuthorizedUser" },
      "description": "Google email allowlist, expiration, remote blocking, update lock, and multi-device hardware binding per user"
    },
    "/access_tokens/{tokenCode}": {
      "schema": { "$ref": "#/entities/AccessToken" },
      "description": "Cloud access tokens issued by Superuser with assigned validity days and single-use redemption state"
    },
    "/team_config/{configId}": {
      "schema": { "$ref": "#/entities/TeamConfig" },
      "description": "Singleton role matrix, app_version notice/enforcement, and shared team feeds managed by Superuser"
    },
