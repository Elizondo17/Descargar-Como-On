        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "titulo",
        "mensaje",
        "prioridad",
        "activo",
        "autorEmail",
        "autorNombre",
        "autorUid",
        "creadoEnMs",
        "createdAt",
        "updatedAt"
      ]
    },
