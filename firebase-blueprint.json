        "requestedParentName": { "type": "string" },
        "targetEmail": { "type": "string" },
        "targetUsername": { "type": "string" },
        "suggestedDays": { "type": "integer" },
        "maxDevices": { "type": "integer" },
        "notes": { "type": "string" },
        "requestedByUid": { "type": "string" },
        "requestedByEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "resolvedByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "requestType", "requestedParentEmail", "requestedParentName", "targetEmail",
        "targetUsername", "suggestedDays", "maxDevices", "notes", "requestedByUid",
        "requestedByEmail", "status", "resolvedByEmail", "createdAt", "updatedAt"
      ]
    },
    "AppErrorReport": {
